# Supabase — from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq API — powers the AI Health & Nutrition Mentor (llama-3.3-70b-versatile)
GROQ_API_KEY=

# Shared secret the Netlify Scheduled Function sends when triggering the
# AI Mentor jobs (no user session exists in that context).
CRON_SECRET=

# Stub provider switches — leave as "mock" until real API access exists.
WORKOUT_PROVIDER=mock
CARDIO_PROVIDER=mock
CRM_PROVIDER=mock

# Shared secret GHL webhooks must pass as ?secret=<value> on /api/webhooks/ghl
GHL_WEBHOOK_SECRET=

# Hevy API — real workout sync (requires Hevy Pro). https://hevy.com/settings?developer
HEVY_API_KEY=

# The one JARVIS account — every request signs in as this automatically
# (see lib/supabase/middleware.ts). Set in Netlify too (Production scope) —
# this is what makes auto-auth work in production, not just locally.
JARVIS_ACCOUNT_EMAIL=
JARVIS_ACCOUNT_PASSWORD=

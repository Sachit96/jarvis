# Every variable below is read somewhere in the codebase — this file has no
# unused/legacy entries. JARVIS has no authentication, so there is no anon
# key, session secret, or account credential to configure.

# Supabase — Project Settings > API. Required. Only the service-role key is
# used (lib/supabase/server.ts, admin.ts) — there's no per-request session,
# so the public anon key is never read by this app.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the external scheduler (Netlify Scheduled Function, GitHub
# Actions cron, etc.) sends as `Authorization: Bearer <value>` when hitting
# POST /api/mentor/run. Required for that route; nothing else uses it.
CRON_SECRET=

# Shared secret GHL webhooks must pass as ?secret=<value> on
# /api/webhooks/ghl. Required only if GoHighLevel webhook sync is configured.
GHL_WEBHOOK_SECRET=

# Hevy API — real workout sync (requires Hevy Pro). https://hevy.com/settings?developer
# Optional — /health/workouts and the dashboard degrade gracefully (sync
# silently skipped) if unset.
HEVY_API_KEY=

# Lead Research Agent (Business > Lead Research). One Google Cloud API key
# with "Places API (New)" and "PageSpeed Insights API" both enabled — see
# console.cloud.google.com > APIs & Services > Library. Required for that
# page's Discovery/Audit stages.
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# Gemini API — powers both the AI Mentor (daily brief, weekly review, general
# chat, nutrition chatbot — lib/ai/providers/gemini-mentor-provider.ts) and
# Lead Research's Stage 3 qualification call
# (lib/ai/providers/gemini-lead-qualifier.ts). One key, two call sites.
# Required for /mentor, the nutrition chatbot, and Lead Research; all degrade
# gracefully (rendered as "not configured") if unset. aistudio.google.com/apikey
GEMINI_API_KEY=

# HTTP Basic Auth gate (proxy.ts) for the whole deployed site — this app has
# no user auth at all and holds real finance/health/memory data. Unset means
# the site is fully public; set this before the next deploy. Any username
# works, only the password is checked.
SITE_PASSWORD=

# SMS logging engine (app/api/sms/webhook/route.ts) — text JARVIS a workout,
# meal, task completion, study session, or freeform note and it logs it.
# All four required together; the webhook responds with empty TwiML (no-op)
# until they're all set. Get ACCOUNT_SID/AUTH_TOKEN from your Twilio Console,
# buy/configure a number there for PHONE_NUMBER, and point that number's
# "A MESSAGE COMES IN" webhook at https://<your-domain>/api/sms/webhook.
# OWNER_PHONE_NUMBER is the only sender that's ever processed (E.164 format,
# e.g. +15551234567) — everything else is silently ignored.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE_NUMBER=

# YouTube upload path (Work Order 7) — OAuth2, "Connect YouTube" in
# Settings. Google Cloud Console > APIs & Services > Credentials > Create
# Credentials > OAuth client ID > Web application. Authorized redirect
# URIs must include, exactly:
#   https://<your-deployed-domain>/api/youtube/oauth/callback
#   http://localhost:3000/api/youtube/oauth/callback   (for local testing)
# While the OAuth consent screen is in "Testing" publishing status,
# Google expires refresh tokens after 7 days regardless of use — the
# Settings card warns you before that happens. Optional — /youtube's
# upload/publish actions degrade to "not connected" if unset.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Anthropic — the ONLY paid path in this app (no ongoing free tier, unlike
# every Gemini tier used elsewhere: one-time trial credit, then
# pay-per-token). Optional — only unlocks an alternative lead qualifier
# (lib/ai/providers/anthropic-lead-qualifier.ts) for Lead Research's Stage
# 3, used only when set AND lifetime spend is under the configurable cap
# in Settings (default $3); Gemini's Flash-Lite qualifier is the default
# and everything falls back to it otherwise. console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase — from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq API — powers the AI Health & Nutrition Mentor (llama-3.3-70b-versatile)
GROQ_API_KEY=

# Shared secret the Netlify Scheduled Function sends when triggering the
# AI Mentor jobs (no user session exists in that context).
CRON_SECRET=

# Stub provider switches — leave as "mock" until real API access exists.
WORKOUT_PROVIDER=mock
CARDIO_PROVIDER=mock
CRM_PROVIDER=mock
